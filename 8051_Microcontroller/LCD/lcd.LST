   1          // program on lcd
   2          #include <reg51.h>
   3          #define lcd P2
   4          sbit rs = P1^0;
   5          sbit rw = P1^1;
   6          sbit e  = P1^2;
   7          void lcd_cmd(unsigned char);
   8          void lcd_data(unsigned char);
   9          void delay (int);
  10          void main()
  11          {
  12   1        lcd_cmd(0x38);    //initializing two lines in 8 bit mode   
  13   1        lcd_cmd(0x01);   // clear
  14   1        lcd_cmd(0x0c);  //display on;display off;
  15   1        lcd_cmd(0x80);  //line 1 ; position 1
  16   1        // 
  17   1        lcd_data('h');
  18   1        lcd_data('e');
  19   1        lcd_data('l');
  20   1        lcd_data('l');
  21   1        lcd_data('0');
  22   1        lcd_cmd(0xc0); 
  23   1        lcd_data('w');
  24   1        lcd_data('o');
  25   1        lcd_data('r');
  26   1        lcd_data('l');
  27   1        lcd_data('d');
  28   1        while (1);
  29   1      }
  30          void lcd_cmd(unsigned char x)
  31          {
  32   1        lcd = x;  //pass data on dataline
  33   1        rs  = 0;  //configure rs in command mode
  34   1        rw = 0;   // configure rw in write mode
  35   1        e = 1;    // enable high
  36   1        delay(4);    
  37   1        e = 0;    //enable high
  38   1      }
  39          void lcd_data(unsigned char x)
  40          { lcd = x;
  41   1        rs = 1;
  42   1        rw = 0;
  43   1        e = 1;
  44   1        delay(4);
  45   1        e = 0;
  46   1      }
  47          void delay(int t)
  48          {
  49   1        int i,j;
  50   1        for(i=0;i<t;i++)
  51   1        for(j=0;j<100;j++);
  52   1      }


